#!/bin/sh
# agent-memory git pre-commit hook (host-agnostic).
#
# Runs the ephemeral sync script when co-installed, then reminds when staged
# work has no .agents/memory/ change (semantic fields may still need
# /agent-memory sync). Never blocks the commit. Fails open.
#
# Install:
#   cp hooks/git/pre-commit .git/hooks/pre-commit
#   cp hooks/agent-memory-hooks/agent-memory-*.sh .git/hooks/
#   chmod +x .git/hooks/pre-commit .git/hooks/agent-memory-*.sh

# GIT_PREFIX is the subdirectory where the user ran `git commit`, not the repo
# root — never use it as PROJECT_DIR (would skip memory when committing from src/).
cwd=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -d "$cwd/.agents/memory" ] || exit 0

hook_dir=$(dirname "$0")
if [ -x "$hook_dir/agent-memory-sync.sh" ]; then
  # Pre-commit has no harness stdin session id — drop inherited binding env and
  # host label so a stale shell cannot rebind or apply OpenCode day-rollover rules.
  AGENT_MEMORY_EVENT=precommit AGENT_MEMORY_HOST=git AGENT_MEMORY_PROJECT_DIR="$cwd" \
    env -u AGENT_MEMORY_SESSION_ID -u CURSOR_SESSION_ID -u GEMINI_SESSION_ID \
      -u AGENT_MEMORY_HOST \
    "$hook_dir/agent-memory-sync.sh" || true
fi

# Branch sanitization must mirror common.sh:sanitize_branch so the reminder
# path matches active-work filenames. (This hook is /bin/sh and does not source
# common.sh, so the logic is duplicated by necessity.)
branch=$(git branch --show-current 2>/dev/null)
branch=$(printf '%s' "$branch" | tr -c 'A-Za-z0-9._-' '-')
[ -n "$branch" ] || branch="local"

# Checkpoint SHA parse must mirror common.sh:parse_checkpoint_sha (this hook is
# /bin/sh and does not source common.sh, so the sed is duplicated by necessity).
aw="$cwd/.agents/memory/active-work/$branch.md"
head_full=$(git rev-parse HEAD 2>/dev/null || true)
head_short=$(git rev-parse --short HEAD 2>/dev/null || true)
if [ -f "$aw" ] && [ -n "$head_full" ]; then
  ck_line=$(grep -E '^Checkpoint:' "$aw" 2>/dev/null | head -1 || true)
  ck_sha=$(printf '%s' "$ck_line" | sed -E 's/^Checkpoint:[[:space:]]*[`"]?[0-9]{4}-[0-9]{2}-[0-9]{2}[`"]?[[:space:]]*@[[:space:]]*[`"]?([0-9a-fA-F]{4,40})[`"]?.*/\1/')
  # Only trust hex SHAs (mirrors parse_checkpoint_sha in agent-memory-common.sh).
  if ! printf '%s' "$ck_sha" | grep -Eq '^[0-9a-fA-F]{4,40}$'; then
    ck_sha=""
  fi
  if [ -n "$ck_sha" ] && [ "$ck_sha" != "<short-sha>" ]; then
    ck_full=$(git rev-parse --end-of-options "$ck_sha" 2>/dev/null || true)
    if [ -z "$ck_full" ] || [ "$ck_full" != "$head_full" ]; then
      cat <<EOF

[agent-memory] active-work Checkpoint ($ck_sha) is behind HEAD ($head_short).
Update resume fields in \`.agents/memory/active-work/$branch.md\` or run
\`/agent-memory sync\` (catch-up) before relying on memory.
(This is a reminder, not a block — the commit will proceed.)

EOF
    fi
  fi
fi

staged=$(git diff --cached --name-only 2>/dev/null | grep -v '^\.agents/memory/' || true)
[ -n "$staged" ] || exit 0

memory_staged=$(git diff --cached --name-only 2>/dev/null | grep '^\.agents/memory/' || true)

if [ -z "$memory_staged" ]; then
  cat <<EOF

[agent-memory] Staged work on branch '$branch' but no .agents/memory/ change in this commit.
Hooks updated ephemeral evidence only. Review resume fields in
\`.agents/memory/active-work/$branch.md\` (if present) and run \`/agent-memory sync\`
for semantic outcomes (primary write is in-turn; sync is catch-up).
(This is a reminder, not a block — the commit will proceed.)

EOF
fi
exit 0
