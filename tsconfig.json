{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "bun-types"]
  },
  "include": [
    "src/**/*.ts",
    "hooks/opencode/**/*.ts",
    "tests/**/*.ts"
  ]
}
